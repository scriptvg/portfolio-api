# portfolio-api (Drizzle + MySQL)

LOG_LEVEL='log_level'

NODE_ENV='node_env'

PORT='port'

# Comma-separated. Must include your Vite dev server (e.g. http://localhost:5173).
CORS_ORIGIN='http://localhost:5173,http://localhost:3000'

# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL='mysql://root:changeme@127.0.0.1:3306/portfolio'

# Long random string; send as Authorization: Bearer <API_ADMIN_SECRET>
API_ADMIN_SECRET='change-me-min-16-chars'

# express-session (OAuth state / login flow)
SESSION_SECRET='change-me-min-16-chars'

# JWT returned to SPA after OAuth success (Authorization: Bearer <token>)
JWT_SECRET='change-me-min-16-chars'
JWT_EXPIRES_IN='7d'

# Frontend URL (Vite default :5173). OAuth redirect: {CLIENT_URL}/auth/callback?token=...
CLIENT_URL='http://localhost:5173'

# Opcional: URL pública de esta API (sin barra final). POST /auth/link/* usa esto en redirectUrl.
# Debe coincidir en host/puerto con GITHUB_CALLBACK_URL / GOOGLE_CALLBACK_URL (ej. http://localhost:9000; no mezclar localhost con 127.0.0.1).
# API_PUBLIC_URL=http://localhost:9000

# Producción detrás de proxy inverso: TRUST_PROXY=1 respeta X-Forwarded-* si no defines API_PUBLIC_URL.
# TRUST_PROXY=1

# Google — set all three or omit / leave empty
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GOOGLE_CALLBACK_URL=''

# GitHub — set all three or omit / leave empty
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''
# Única URL en GitHub OAuth App: login y vincular desde el panel comparten este callback.
# GITHUB_CALLBACK_URL='http://localhost:9000/api/v1/auth/github/callback'
GITHUB_CALLBACK_URL=''

# Optional OAuth link callback for Google only (defaults: .../google/callback -> .../link/google/callback).
GOOGLE_LINK_CALLBACK_URL=''

# Email/password: POST /api/v1/auth/signup | POST /api/v1/auth/signin
# Link password (logged in, OAuth-only user): POST /api/v1/auth/link/password
# Link Google/GitHub (logged in): POST /api/v1/auth/link/google | .../link/github → open redirectUrl with cookies

# Comma-separated emails that may mutate dashboard/API data with their JWT (technologies, future modules, etc.).
# Leave empty in development to allow any logged-in user; in production, set explicitly (or use only API_ADMIN_SECRET).
DASHBOARD_WRITE_EMAILS=''

# Rate limiting — global API defaults
# RATE_LIMIT_WINDOW_MS='60000'
# RATE_LIMIT_MAX='100'

# AES-256-GCM key for encrypting at-rest secrets (e.g. GitHub PATs stored in DB).
# Min 32 chars. Falls back to SESSION_SECRET in development if unset.
# Rotating this value invalidates all existing encrypted ciphertexts.
# APP_ENCRYPTION_KEY='change-me-min-32-chars-for-aes256'

# GitHub Personal Access Token (public, read-only) for the GitHub Integration module.
# Without this, unauthenticated GitHub API requests are rate-limited to 60 req/h.
# GITHUB_PUBLIC_TOKEN=''

# ─── IA (puertos y adaptadores) ──────────────────────────────────────────────
# Proveedor de IA activo. Hoy solo "ollama".
AI_PROVIDER='ollama'
# Servidor Ollama local, sin barra final.
OLLAMA_BASE_URL='http://localhost:11434'
# Modelo de chat por defecto. `gemma4:31b-cloud` es un modelo de Ollama Cloud:
# NO se descarga localmente; requiere autenticarse con `ollama signin`.
OLLAMA_DEFAULT_MODEL='gemma4:31b-cloud'
# Modelo de embeddings por defecto (`ollama pull nomic-embed-text`).
OLLAMA_EMBEDDING_MODEL='nomic-embed-text'
# Timeout por petición a la IA en milisegundos.
AI_REQUEST_TIMEOUT_MS='120000'

# Admin seed — used ONLY by `pnpm db:seed:admin`. NEVER commit real values.
# Run: SEED_EMAIL='admin@example.com' SEED_PASSWORD='strong-password' pnpm db:seed:admin
SEED_EMAIL=
SEED_PASSWORD=
