    "/ai/": {
      "get": {
        "tags": [
          "AI"
        ],
        "summary": "Health del proveedor de IA configurado",
        "description": "Devuelve disponibilidad y modelos del proveedor. 503 si no es reachable.",
        "responses": {
          "200": {
            "description": "Proveedor reachable (ProviderHealth en data)"
          },
          "503": {
            "description": "Proveedor no reachable (envoltura success:false)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/ai/chat": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Chat completion (one-shot o streaming SSE)",
        "description": "Si stream:false devuelve ChatResponse envuelto. Si stream:true responde text/event-stream (SSE): eventos data: con ChatStreamChunk y cierre data: [DONE]. El modo SSE es una excepcion deliberada a la envoltura JSON estandar.",
        "produces": [
          "text/event-stream"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "example": "user"
                      },
                      "content": {
                        "type": "string",
                        "example": "Hola"
                      }
                    }
                  }
                },
                "model": {
                  "type": "string",
                  "example": "llama3.1"
                },
                "temperature": {
                  "type": "number",
                  "example": 0.7
                },
                "maxTokens": {
                  "type": "number",
                  "example": 512
                },
                "stream": {
                  "type": "boolean",
                  "example": false
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ChatResponse (JSON) o stream SSE segun stream"
          },
          "404": {
            "description": "Modelo inexistente"
          },
          "502": {
            "description": "Respuesta invalida del proveedor"
          },
          "503": {
            "description": "Proveedor no disponible / timeout"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/ai/embeddings": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Genera embeddings de uno o varios textos",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "array",
                  "example": [
                    "texto a vectorizar"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "model": {
                  "type": "string",
                  "example": "nomic-embed-text"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "EmbeddingResponse (embeddings: number[][]) en data"
          },
          "503": {
            "description": "Proveedor no disponible / timeout"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
